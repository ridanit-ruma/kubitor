{
  "name": "kubitor",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.3.0",
  "engines": {
    "node": ">=26.0.0"
  },
  "scripts": {
    "typecheck": "pnpm run build:shared && pnpm -r --workspace-concurrency=1 typecheck",
    "test": "pnpm run build:shared && pnpm -r --workspace-concurrency=1 test",
    "lint": "biome check .",
    "format": "biome check --write .",
    "build:shared": "pnpm --filter @kubitor/shared build"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.11",
    "@types/node": "^26.4.0",
    "typescript": "^7.0.2",
    "vitest": "^4.1.11"
  }
}
