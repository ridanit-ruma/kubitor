{
  "extends": "../tsconfig.base.json",
  "compilerOptions": {
    "rootDir": "src",
    "outDir": "dist",
    "types": ["node"],
    // Decorators only. No `emitDecoratorMetadata`: every provider is injected
    // by an explicit token, so nothing reads `design:paramtypes` and the test
    // runner needs no metadata transform.
    "experimentalDecorators": true
  },
  // The build emits sources only; `tsconfig.test.json` is what typechecks
  // the tests, so `dist` never carries a test file or a devDependency import.
  "include": ["src/**/*.ts"],
  "exclude": ["**/*.test.ts", "**/test/**"]
}
